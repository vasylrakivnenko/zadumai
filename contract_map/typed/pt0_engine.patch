+"""
+Located reading (2026-10-04): local answers for questions about LONG documents, which Pre-Tier 0 rarely answers on the
+whole text and the reader network doesn't read (its long-document answers are off: 68-89% on whole contracts).
+
+    1. Compile the document once (router/doccompile.py: page furniture out, structure, sections, statements with their
+       lead-ins, parties), cut it into pieces of at most PIECE_CHARS (statements of one section, its heading in front).
+    2. Locate the K_LOCATE pieces for the question: shared word lemmas (spaCy; lexicon synonyms count) and the
+       embedder's ranking, fused by rank; a piece holding the question's action concept (Pre-Tier 0's frame) ranks
+       higher.
+    3. Read a short "located document": a line naming the parties (so the party checks know them) + those pieces in
+       document order. Pre-Tier 0 on it, then the reader network (its party / negation / modality checks and its
+       conflict rule), its "yes" at T_LOCATED; its "no" stays off, as everywhere.
+Measured in /root/zadumai_nli_proto/contract_map/typed (RESULTS.md, RESULTS_NS.md): the gold clause is in the 6 located
+pieces for 91.5% of tuning NDA questions (lemmas; 88.2% with 5-letter stems); user questions over whole commercial
+contracts (wc1, 126 sealed questions): 6 -> 27 answered, all right; held-out NDAs (959 x the 17 questions) 186 @ 92.5%
+(Pre-Tier 0 + this, today's network); CUAD's checklist questions are its weak spot (category questions under CUAD's
+own definitions, ~85% by CUAD's labels).
+Compiling and embedding a contract takes ~3 s on the first question (cached per document), then ~0.6 s per question.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import threading
+from collections import OrderedDict
+
+from router import frames
+from router import netreader as NR
+from router.doccompile import compile_doc
+from router.pretier0 import check as pt0_check
+
+LONG_CHARS = 3000  # shorter documents: the network reads them whole already
+PIECE_CHARS = 600
+K_LOCATE = 6
+T_LOCATED = 0.90  # nda tuning: 87/88 right at >= 0.90; the network's own 0.94 (set on short texts) kept 15
+T_LOCATED_FT = 0.951  # the retrained network (netreader.MODEL_DIR_FT): picked on the tuning sets (>= 98% there)
+CACHE_DOCS = 32
+
+_NLP = None
+_NLP_LOCK = threading.Lock()
+
+
+def lemmas(text: str) -> set:
+    """Content-word lemmas (spaCy en_core_web_sm, tagger + lemmatizer)."""
+    global _NLP
+    with _NLP_LOCK:
+        if _NLP is None:
+            import spacy
+            _NLP = spacy.load("en_core_web_sm", disable=["parser", "ner"])
+        doc = _NLP(text.lower()[:20000])
+    return {t.lemma_.lower() for t in doc if t.is_alpha and len(t) > 2 and t.lemma_.lower() not in NR._STOP}
+
+
+_LEMMA_SYN = None
+
+
+def _lemma_synonyms() -> dict:
+    global _LEMMA_SYN
+    if _LEMMA_SYN is None:
+        out = {}
+        for phrases in NR.LEXICON.values():
+            group = set().union(*(lemmas(p) for p in phrases)) if phrases else set()
+            for p in phrases:
+                for w in lemmas(p): out.setdefault(w, set()).update(group)
+        _LEMMA_SYN = out
+    return _LEMMA_SYN
+
+
+class _Compiled:
+    def __init__(self, document: str):
+        c = compile_doc(document)
+        self.parties = c.parties
+        self.pieces = []  # [text]
+        groups = []
+        for st in c.stmts:
+            if st.start < 0 or len(st.own) < 4: continue
+            secs = [i for i in st.secs if not c.sections[i].front]
+            hs = [i for i in secs if c.sections[i].heading]
+            key = hs[-1] if hs else (secs[0] if secs else -1)
+            if groups and groups[-1][0] == key: groups[-1][1].append(st)
+            else: groups.append((key, [st]))
+        for key, sts in groups:
+            head = c.sections[key].heading if key >= 0 else ""
+            cur = []
+            for st in sts:
+                t = re.sub(r"\s+", " ", st.text).strip()
+                if cur and sum(len(x) + 1 for x in cur) + len(t) > PIECE_CHARS:
+                    self._add(cur, head); cur = []
+                cur.append(t[:PIECE_CHARS * 2])
+            if cur: self._add(cur, head)
+        self.lemmas = [lemmas(t) for t in self.pieces]
+        self.vectors = None
+
+    def _add(self, cur, head):
+        body = " ".join(cur)
+        self.pieces.append(f"{head}. {body}" if head and not body.lower().startswith(head.lower()[:20]) else body)
+
+    def party_line(self) -> str:
+        if not self.parties: return ""
