+
+
+from dataclasses import dataclass
+
+
+@dataclass
+class LocatedResult(NR.NetResult):
+    located_text: str = ""  # what was read: the party line + the located pieces (Tier 0 NLI reads it next, harness)
+
+
+class LocatedReader:
+    """`answer(question, document)` like NetReader's, for long documents. Shares the reader network and its embedder."""
