+"""The located reading (router/located.py) and its switch (2026-10-04)."""
+from router import netreader as NR
+from router.located import LONG_CHARS, LocatedReader
+from router.stages import Stages
+
+CONTRACT = "\n".join([
+    "CONSULTING AGREEMENT",
+    'This Consulting Agreement is made by and between SanDisk Corporation, a Delaware corporation ("SanDisk"), and '
+    'John Smith, an individual ("Consultant").',
+    "1. Services. Consultant shall perform the services described in Exhibit A. " + "The services are general. " * 40,
+    "2. Fees. SanDisk shall pay Consultant the fees set out in Exhibit A within thirty days of invoice. " + "Fees are fixed. " * 40,
+    "3. Subcontractors. Consultant shall not utilize third party contractors to perform the Services without SanDisk's "
+    "prior written approval.",
+    "4. Term. This Agreement shall continue for one year. " + "The term is fixed. " * 40,
+    "5. Notices. All notices under this Agreement shall be given in writing.",
+    "6. Governing Law. This Agreement shall be governed by the laws of the State of California.",
+])
+
+
+class _StubNet:
+    """p(no), p(yes), p(none): "yes" 0.95 on a unit that says notices are given in writing, else "doesn't settle it"."""
+    def __call__(self, pairs):
+        return [[0.02, 0.95, 0.03] if "notices" in t.lower() and "writing" in t.lower() else [0.02, 0.03, 0.95]
+                for t, _ in pairs]
+
+
+def _reader():
+    net = NR.NetReader(net=_StubNet())
+    net._embed = lambda texts: __import__("numpy").ones((len(texts), 4)) / 2.0
+    return LocatedReader(net)
+
+
+def test_switch_defaults_and_mask():
+    st = Stages()
+    assert st.located is False and " l1" not in st.mask("off")
+    on = Stages.from_dict({"located": True}, st)
+    assert on.located and " l1" in on.mask("off")
+
+
+def test_short_documents_are_left_to_the_network():
+    r = _reader().answer("Must notices be given in writing?", "Notices shall be given in writing.")
+    assert not r.fired and "short" in r.reason
+
+
+def test_locates_the_clause_and_answers():
+    assert len(CONTRACT) >= LONG_CHARS
+    lr = _reader()
+    cd = lr.compiled(CONTRACT)
+    idx = lr.locate("Must notices be given in writing?", cd, set())
+    assert any("writing" in cd.pieces[i] for i in idx)
+    r = lr.answer("Must notices be given in writing?", CONTRACT)
+    assert r.fired and r.answer == "yes"
+    assert lr.compiled(CONTRACT) is cd  # cached per document
+
+
+def test_retrained_network_switch_in_mask():
+    st = Stages.from_dict({"tier0net": True, "netft": True})
+    assert " f1" in st.mask("off") and Stages().netft is False
+
+
+# ---- the harness's order with the located reading on (stubs: no models, no LLM)
+from router.harness import Answer, Harness  # noqa: E402
+from router.located import LocatedResult  # noqa: E402
+from router.tier0 import Tier0Result  # noqa: E402
+
+
+class _T0:
+    def __init__(self, fire_on=""):
+        self.seen, self.fire_on = [], fire_on
+    def answer(self, q, doc):
+        self.seen.append(doc)
+        fired = bool(self.fire_on) and self.fire_on in doc
+        return Tier0Result(fired, "yes" if fired else None, 0.97 if fired else 0.0, "stub", hypothesis=q)
+
+
+class _Loc:
+    def __init__(self, fire):
+        self.fire = fire; self.name = "Tier 0 (located reading)"
+    def answer(self, q, doc, p0=None):
+        return LocatedResult(self.fire, "yes" if self.fire else None, 0.95 if self.fire else 0.0, "stub",
+                             located_text="LOCATED: notices shall be given in writing.")
+
+
+def _harness(t0, loc):
+    h = Harness(None, None, None, tier0=t0, pretier0=False, classifiers=False, located=loc)
+    h._answer = lambda q, d: Answer(question=q, answer="deferred", confidence=0.0, path="deferred", reason="stub")
+    h._calls = lambda: 0
+    return h
+
+
+def test_long_documents_located_reading_and_no_nli():
+    t0 = _T0(fire_on="CONSULTING")
+    a = _harness(t0, _Loc(True))._lookup("Must notices be given in writing?", CONTRACT)
+    assert a.path == "located" and a.answer == "yes" and t0.seen == []  # NLI doesn't read long documents
